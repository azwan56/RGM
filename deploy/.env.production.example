# ==============================================================================
# RGM 国内生产环境 (阿里云 ECS + 域名) 环境变量配置
# ==============================================================================

# 1. 域名与服务地址
NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.cn
NEXT_PUBLIC_SUPABASE_URL=https://db.yourdomain.cn
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_production_anon_key

# 2. Supabase 生产密钥
SUPABASE_URL=http://rgm-supabase-kong:8000
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_production_service_key
SUPABASE_JWT_SECRET=your_32_characters_minimum_jwt_secret_key!

# 3. 阿里云 DashScope / 通义千问 / DeepSeek
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_WORKSPACE_ID=your_dashscope_workspace_id_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your_dashscope_or_openai_api_key_here
LLM_MODEL=qwen-max

# 4. 微信小程序凭证
WECHAT_APP_ID=wx1234567890abcdef
WECHAT_APP_SECRET=your_wechat_app_secret_here

# 5. 系统加密密钥 (AES-256) 与超级管理员强密码
SECRET_KEY=replace-with-at-least-32-char-random-encryption-key
RGM_ADMIN_EMAIL=admin@yourdomain.cn
RGM_ADMIN_PASSWORD=replace-with-strong-super-admin-password
