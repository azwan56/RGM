# ==============================================================================
# RGM 国内版 (Alibaba Cloud + Supabase + Garmin + WeChat) 环境配置
# ==============================================================================

# 1. 服务基础配置
ENVIRONMENT=development
PORT=8000
SECRET_KEY=rgm-cn-secret-encryption-key-must-be-32-chars-long!!

# 2. Supabase 数据库与 Auth 配置
SUPABASE_URL=http://localhost:8000
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.fake_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.fake_service_key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-minimum-32-chars

# 3. 阿里云 DashScope / 通义千问 / DeepSeek 大模型配置
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_MODEL=qwen-max
# 兼容接口 (支持 DeepSeek / 任何 OpenAI 兼容接口 / 阿里云百炼专属空间)
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-your-dashscope-api-key

# 4. 微信小程序与微信开放平台凭证
WECHAT_APP_ID=your_miniapp_appid
WECHAT_APP_SECRET=your_miniapp_appsecret

# 5. 阿里云短信配置 (可选，用于手机号验证码)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 6. Redis 配置 (可选，用于定时任务分布式锁和高频缓存)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 7. 调度器配置
ENABLE_SCHEDULER=true
